{
  "private": true,
  "type": "module",
  "name": "todo-demo",
  "version": "3.5.12",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:nextjs": "pnpm -r --filter ./apps/nextjs-app dev",
    "build:nextjs": "pnpm -r --filter ./apps/nextjs-app build",
    "preview:nextjs": "pnpm -r --filter ./apps/nextjs-app start",
    "dev:react": "pnpm -r --filter ./apps/react-app dev",
    "build:react": "pnpm -r --filter ./apps/react-app build",
    "preview:react": "pnpm -r --filter ./apps/react-app preview",
    "dev:vue": "pnpm -r --filter ./apps/vue-app dev",
    "build:vue": "pnpm -r --filter ./apps/vue-app build",
    "preview:vue": "pnpm -r --filter ./apps/vue-app preview",
    "dev:solid": "pnpm -r --filter ./apps/solid-app dev",
    "build:solid": "pnpm -r --filter ./apps/solid-app build",
    "preview:solid": "pnpm -r --filter ./apps/solid-app preview"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^0.6.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.7",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  },
  "dependencies": {
    "dayjs": "^1.11.18",
    "immer": "^10.1.3",
    "nanoid": "^5.1.6",
    "rxjs": "^7.8.2"
  }
}
